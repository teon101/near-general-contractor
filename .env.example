# Copy to .env and fill in. Never commit .env.

# simulate = no chain (default) | near = native NEAR on testnet | usdc = NEP-141 USDC on testnet
PAYMENT_RAIL=simulate
NEAR_NETWORK=testnet
# NEAR_RPC_URL=https://rpc.testnet.near.org

# The contractor's OWN wallet. Use a dedicated sub-account that only holds the budget for this run.
CONTRACTOR_ACCOUNT_ID=
CONTRACTOR_PRIVATE_KEY=

# Where each worker gets paid. These accounts must exist on testnet. They are also the payee allowlist.
PAYEE_QUICKDATA=
PAYEE_DATAFEED=
PAYEE_CHARTSMITH=
PAYEE_PENPAL=

# Only for PAYMENT_RAIL=usdc: a NEP-141 USDC token on testnet that your contractor account holds
USDC_CONTRACT=
USDC_DECIMALS=6

# Spending policy
CONTINGENCY_SHARE=0.1
WALK_AWAY_MULTIPLIER=1.2
MAX_SINGLE_PAYMENT_SHARE=0.5

# Agent Market (read-only, for reference prices). Set to 0 to skip the live lookup.
USE_LIVE_MARKET=1
MARKET_API=https://market.near.ai

# NEAR AI Cloud key (cloud.near.ai). Powers planning, counter-offers, in-house work and AI checks.
# Without it the agent falls back to built-in rules and templates.
LLM_API_KEY=
LLM_BASE_URL=https://cloud-api.near.ai/v1
# LLM_MODEL is optional; if unset the best available model from the NEAR AI Cloud catalog is picked
LLM_MODEL=

# Refuse mainnet unless this is 1
ALLOW_MAINNET=0

# NEAR Intents (1Click). With PAYMENT_RAIL=near, workers who want USDC are settled via Intents.
# Testnet: live dry-run quote + NEAR paid on testnet. Mainnet: real swap, needs ALLOW_MAINNET=1 and INTENTS_EXECUTE=1.
USE_INTENTS=1
INTENTS_EXECUTE=0
# ONECLICK_API_KEY=
